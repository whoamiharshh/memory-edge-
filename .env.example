# Edge Memory local configuration
# Copy to .env only if you need to override defaults.
EDGE_HOST=127.0.0.1
EDGE_PORT=8101
CLOUD_HOST=127.0.0.1
CLOUD_PORT=8100
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
EDGE_PROFILE=bearing-12k
EDGE_COMPONENT=bearing
EDGE_SITE=site1
EDGE_DEVICE=devA
# Use long random values outside the demo.
EDGE_OPERATOR_TOKEN=operator-devA
EDGE_DEVICE_TOKEN=
EDGE_CLOUD_URL=http://127.0.0.1:8100

# Ask: web search for questions this device cannot answer from what it holds.
# duckduckgo (default) = DuckDuckGo + Wikipedia, no account and no key needed.
# wikipedia = Wikipedia only.  brave = needs BRAVE_SEARCH_API_KEY.  tavily = needs TAVILY_API_KEY.
# none = online retrieval disabled entirely.
EDGE_SEARCH_PROVIDER=duckduckgo
# BRAVE_SEARCH_API_KEY=
# TAVILY_API_KEY=
